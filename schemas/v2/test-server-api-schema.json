{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://xmlui-org.github.io/schemas/v2/api.schema.json",
  "title": "XMLUI Test Server API Configuration v2",
  "description": "JSON schema for API endpoints configuration (version 2)",
  "type": "object",
  "required": ["$schemaVersion", "name", "description", "base_path", "endpoints"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri",
      "description": "JSON Schema URL reference"
    },
    "$schemaVersion": {
      "type": "integer",
      "const": 2,
      "description": "Schema version marker"
    },
    "name": {
      "type": "string",
      "description": "Name of the API configuration",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "description": "Description of the API",
      "minLength": 1
    },
    "webroot": {
      "type": "string",
      "description": "Root directory from which to server from",
    },
    "base_path": {
      "type": "string",
      "description": "Common prefix for all endpoints (replaces basePath from v1)",
      "pattern": "^/.*"
    },
    "endpoints": {
      "type": "array",
      "description": "Array of API endpoint definitions",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/endpoint"
      }
    }
  },
  "additionalProperties": true,
  "definitions": {
    "endpoint": {
      "type": "object",
      "required": ["endpoint"],
      "properties": {
        "endpoint": {
          "type": "string",
          "description": "HTTP method and URL path pattern (e.g., 'GET /users/:id')",
          "pattern": "^(GET|POST|PUT|DELETE|PATCH|HEAD|OPTIONS)\\s+/.*"
        },
        "description": {
          "type": "string",
          "description": "Description of what this endpoint does",
          "minLength": 1
        },
        "query": {
          "type": "string",
          "description": "Inline SQL query to execute",
          "minLength": 1
        },
        "query_file": {
          "type": "string",
          "description": "Path to external SQL file to execute",
          "minLength": 1
        },
        "params": {
          "$ref": "#/definitions/params"
        },
        "rows_expected": {
          "type": "string",
          "enum": ["one", "one?", "many", "many?"],
          "default": "many?",
          "description": "Expected result cardinality"
        },
        "row_type": {
          "type": "string",
          "enum": ["json", "integer", "real", "string", "columns", "integer?", "real?", "string?", "columns?", "json?"],
          "default": "json",
          "description": "Row data type (? suffix allows NULL values)"
        },
        "column_types": {
          "type": "array",
          "description": "Column types when row_type is 'columns'",
          "items": {
            "type": "string",
            "enum": ["json", "integer", "real", "string", "columns", "integer?", "real?", "string?", "columns?", "json?"]
          }
        }
      },
      "oneOf": [
        {
          "required": ["query"],
          "not": { "required": ["query_file"] }
        },
        {
          "required": ["query_file"],
          "not": { "required": ["query"] }
        }
      ],
      "additionalProperties": true
    },
    "params": {
      "type": "object",
      "description": "Parameter definitions using shorthand syntax",
      "patternProperties": {
        "^[a-zA-Z_][a-zA-Z0-9_]*\\??$": {
          "type": "string",
          "enum": ["string", "int", "real", "bool"],
          "description": "Parameter type (? suffix = optional)"
        }
      },
      "additionalProperties": false
    }
  }
}