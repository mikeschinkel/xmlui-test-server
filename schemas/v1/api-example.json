{
  "apiVersion": "1.0",
  "name": "xmlui-localsvr-demo-api",
  "description": "Demo API for xmlui-localsvr",
  "basePath": "/api",
  "endpoints": [
    {
      "path": "/sqlite",
      "methods": {
        "GET": {
          "description": "Report SQLite version",
          "sql": "select sqlite_version() as version"
        }
      }
    },
    {
      "path": "/postgres",
      "methods": {
        "GET": {
          "description": "Report Postgres version",
          "sql": "select version() as version"
        }
      }
    },
    {
      "path": "/query_from_file",
      "methods": {
        "GET": {
          "description": "Report Postgres version",
          "sqlFile": "query.sql"
        }
      }
    }
  ]
}
