{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://xmlui-org.github.io/schemas/v1/test-server.schema.json",
  "title": "XMLUI Test Server Configuration",
  "description": "JSON schema for XMLUI test server configuration",
  "type": "object",
  "required": ["$schemaVersion"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri",
      "description": "JSON Schema URL reference"
    },
    "$schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Schema version marker for validation and migration"
    },
    "server": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 8080
        },
        "host": {
          "type": "string",
          "default": "localhost"
        },
        "api_config": {
          "type": "string",
          "description": "Path to API configuration file"
        },
        "verbose": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": true
    },
    "database": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "description": "Database type identifier"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": { "const": "sqlite3" }
            }
          },
          "then": {
            "properties": {
              "filepath": {
                "type": "string",
                "description": "Path to SQLite database file"
              },
              "open_params": {
                "type": "object",
                "description": "Key-value pairs appended to DSN as ?k=v&k2=v2",
                "additionalProperties": { "type": "string" }
              },
              "init_sql": {
                "type": "array",
                "description": "SQL statements executed once after connection before any extensions",
                "items": { "type": "string" }
              },
              "post_load_sql": {
                "type": "array", 
                "description": "SQL statements executed once after all extensions complete",
                "items": { "type": "string" }
              },
              "extensions": {
                "$ref": "#/definitions/extensions"
              }
            },
            "additionalProperties": true
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "postgres" }
            }
          },
          "then": {
            "properties": {
              "connection_string": {
                "type": "string",
                "description": "PostgreSQL connection string"
              },
              "init_sql": {
                "type": "array",
                "description": "SQL statements executed once after connection",
                "items": { "type": "string" }
              },
              "post_load_sql": {
                "type": "array",
                "description": "SQL statements executed after initialization",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": true
          }
        },
        {
          "if": {
            "properties": {
              "type": { "const": "duckdb" }
            }
          },
          "then": {
            "properties": {
              "filepath": {
                "type": "string",
                "description": "Path to DuckDB database file"
              },
              "init_sql": {
                "type": "array",
                "description": "SQL statements executed once after connection",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": true
          }
        }
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "definitions": {
    "extensions": {
      "type": "array",
      "description": "SQLite extension configuration entries",
      "items": {
        "anyOf": [
          { "$ref": "#/definitions/disableEntry" },
          { "$ref": "#/definitions/inlineManifest" },
          { "$ref": "#/definitions/manifestReference" },
          { "$ref": "#/definitions/shorthandInclude" }
        ]
      }
    },
    "disableEntry": {
      "type": "object",
      "required": ["disable"],
      "properties": {
        "disable": {
          "type": "string",
          "description": "Extension ID to disable, or path to specific binary (absolute, relative to config dir, or ~/home-relative). Parent directory references (..) are forbidden.",
          "not": {
            "pattern": "\\.\\."
          }
        }
      },
      "additionalProperties": false
    },
    "inlineManifest": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9._-]+$",
          "description": "Extension identifier"
        },
        "version": {
          "type": "string",
          "description": "Extension version (SemVer recommended)"
        },
        "title": {
          "type": "string",
          "description": "Human-readable extension title"
        },
        "docs_url": {
          "type": "string",
          "format": "uri",
          "description": "Documentation URL"
        },
        "repo_url": {
          "type": "string", 
          "format": "uri",
          "description": "Repository URL"
        },
        "download_urls": {
          "type": "array",
          "description": "Download URLs with variable expansion support",
          "items": { "type": "string" }
        },
        "filepath": {
          "type": "string",
          "description": "Local file path with variable expansion support"
        },
        "sha256s": {
          "type": "object",
          "description": "Platform-specific SHA256 hashes",
          "patternProperties": {
            "^(darwin|linux|windows)_(amd64|arm64)$": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{64}$"
            }
          },
          "additionalProperties": false
        },
        "entry_point": {
          "type": "string",
          "default": "sqlite3_extension_init",
          "description": "Extension entry point function name"
        },
        "depends_on": {
          "type": "array",
          "description": "Extension IDs this extension depends on",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9._-]+$"
          }
        },
        "load_order": {
          "type": "integer",
          "default": 0,
          "description": "Load order tie-breaker (lower values load first)"
        },
        "on_failure": {
          "type": "string",
          "enum": ["error", "warn", "ignore"],
          "default": "warn",
          "description": "Failure handling policy"
        },
        "vars": {
          "type": "object",
          "description": "Environment variables for extension",
          "additionalProperties": { "type": "string" }
        },
        "var_scope": {
          "type": "string",
          "enum": ["load", "app"],
          "default": "app",
          "description": "Variable scope: 'load' (during load only) or 'app' (process lifetime)"
        },
        "pre_load_sql": {
          "type": "array",
          "description": "SQL executed before loading extension binary",
          "items": { "type": "string" }
        },
        "on_load_sql": {
          "type": "array", 
          "description": "SQL executed after loading extension binary",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "manifestReference": {
      "type": "object",
      "required": ["manifest"],
      "properties": {
        "manifest": {
          "type": "string",
          "description": "Path or URL to external manifest file"
        }
      },
      "additionalProperties": false
    },
    "shorthandInclude": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9._-]+$",
          "description": "Extension ID to include from autoload directories"
        },
        "version": {
          "type": "string",
          "description": "Optional version constraint"
        }
      },
      "additionalProperties": false
    }
  }
}